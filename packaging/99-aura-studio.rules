# Lets the logged-in desktop user talk to supported ASUS ROG devices over hidraw.
# Install:  sudo cp packaging/99-aura-studio.rules /etc/udev/rules.d/ && sudo udevadm control --reload && sudo udevadm trigger
# ROG Azoth (USB)
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1a83", TAG+="uaccess"
# ROG Azoth (2.4 GHz, own dongle)
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1a85", TAG+="uaccess"
# ROG Omni Receiver (Azoth, Harpe Ace Extreme, ...)
SUBSYSTEM=="hidraw", KERNEL=="hidraw*", ATTRS{idVendor}=="0b05", ATTRS{idProduct}=="1ace", TAG+="uaccess"
